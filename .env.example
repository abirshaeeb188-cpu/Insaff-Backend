# ==========================
# Server
# ==========================
PORT=5000
# Your frontend's URL(s) (for CORS). Comma-separate multiple origins.
# This project's frontend dev server runs on 8443 (see frontend/vite.config.ts); 5173 is Vite's default.
# Use your deployed domain(s) in production.
FRONTEND_URL=http://localhost:5173,http://localhost:8443

# ==========================
# NeonDB (Postgres)
# ==========================
# Get this from your Neon dashboard -> Connection Details -> "Pooled connection" string.
# It MUST include ?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
# Leave this unset (or "true") for Neon. Only set to "false" for a local Postgres without SSL.
DATABASE_SSL=true

# ==========================
# JWT (login sessions)
# ==========================
# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ==========================
# SMTP (for sending verification / reset code emails)
# ==========================
# Example using Gmail (requires a 16-character "App Password", not your normal password):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Insaf Sand Trading Company <no-reply@insaf.ae>"

# Where Contact-page inquiries get emailed to. Defaults to SMTP_USER above if left unset.
CONTACT_EMAIL=youraddress@gmail.com
